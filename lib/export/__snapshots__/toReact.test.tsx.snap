// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toReactComponent > keeps a stable shape (snapshot) 1`] = `
""use client";

// Personal loan KYC: generated by KYC Studio.
// Purpose: Verify identity and income to assess a personal loan application
// Needs: react, react-hook-form, zod, @hookform/resolvers
// Validation rules are developer hints, not legal or RBI compliance advice.

import { useState } from "react";
import { useForm, useWatch } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";

const PAN_RE = /^[A-Z]{3}[PCHFATBLJG][A-Z][0-9]{4}[A-Z]$/;
const IFSC_RE = /^[A-Z]{4}0[A-Z0-9]{6}$/;
const MOBILE_RE = /^[6-9][0-9]{9}$/;
const AADHAAR_LAST4_RE = /^[0-9]{4}$/;
const BANK_ACCOUNT_RE = /^[0-9]{9,18}$/;
const GSTIN_RE = /^([0-9]{2})([A-Z0-9]{10})([1-9A-Z])Z([0-9A-Z])$/;
const GSTIN_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

/** GSTIN = state code + PAN + entity no. + "Z" + a mod-36 check digit. */
function isValidGstin(value: string): boolean {
  const match = GSTIN_RE.exec(value);
  if (!match) return false;
  const state = Number(match[1]);
  if (!((state >= 1 && state <= 38) || state === 97 || state === 99)) return false;
  if (!PAN_RE.test(match[2]!)) return false;
  let sum = 0;
  for (let i = 0; i < 14; i++) {
    const product = GSTIN_CHARS.indexOf(value[i]!) * (i % 2 === 0 ? 1 : 2);
    sum += Math.floor(product / 36) + (product % 36);
  }
  return GSTIN_CHARS[(36 - (sum % 36)) % 36] === value[14];
}

const schema = z
  .object({
    "full_name": z.string().trim().min(1, "Full name is required").refine((v) => v === "" || v.length >= 2, "Must be at least 2 characters").refine((v) => v === "" || v.length <= 80, "Must be at most 80 characters"),
    "dob": z.string().trim().min(1, "Date of birth is required"),
    "mobile": z.string().trim().min(1, "Mobile number is required").refine((v) => v === "" || MOBILE_RE.test(v), "Enter a 10-digit mobile number starting with 6-9"),
    "kyc_consent": z.boolean().optional().refine((v) => v === true, "You must agree to continue"),
    "pan_number": z.string().trim().toUpperCase().min(1, "PAN is required").refine((v) => v === "" || PAN_RE.test(v), "Enter a valid PAN, e.g. ABCPD1234E"),
    "aadhaar_last4": z.string().trim().min(1, "Last 4 digits of Aadhaar is required").refine((v) => v === "" || AADHAAR_LAST4_RE.test(v), "Enter exactly 4 digits"),
    "employment_type": z.enum(["salaried", "self_employed"], { error: "Please choose an option" }),
    "gstin": z.string().trim().toUpperCase().refine((v) => v === "" || isValidGstin(v), "Enter a valid GSTIN").optional(),
    "monthly_income": z.string().trim().min(1, "Monthly income (₹) is required").refine((v) => v === "" || !Number.isNaN(Number(v)), "Enter a valid number").refine((v) => v === "" || Number(v) >= 0, "Must be at least 0"),
    "ifsc": z.string().trim().toUpperCase().min(1, "Bank IFSC is required").refine((v) => v === "" || IFSC_RE.test(v), "Enter a valid IFSC, e.g. HDFC0001234"),
    "account_number": z.string().trim().min(1, "Bank account number is required").refine((v) => v === "" || BANK_ACCOUNT_RE.test(v), "Account number must be 9-18 digits"),
  })
  .superRefine((data, ctx) => {
    // GSTIN: only shown when employment_type is self_employed
    if (data["employment_type"] === "self_employed" && !data["gstin"]) {
      ctx.addIssue({ code: "custom", path: ["gstin"], message: "GSTIN is required" });
    }
  });

// What the inputs hold while typing vs what onSubmit receives after Zod
// (e.g. PAN is uppercased). React Hook Form needs to know both.
type PersonalLoanKycFormInput = z.input<typeof schema>;
export type PersonalLoanKycFormValues = z.output<typeof schema>;

const STEPS: { title: string; fields: (keyof PersonalLoanKycFormInput)[] }[] = [
  { title: "Basic details", fields: ["full_name", "dob", "mobile"] },
  { title: "Identity", fields: ["kyc_consent", "pan_number", "aadhaar_last4"] },
  { title: "Income and bank", fields: ["employment_type", "gstin", "monthly_income", "ifsc", "account_number"] },
];

export default function PersonalLoanKycForm({ onSubmit }: { onSubmit: (values: PersonalLoanKycFormValues) => void }) {
  const [step, setStep] = useState(0);
  const {
    register,
    handleSubmit,
    trigger,
    control,
    formState: { errors },
  } = useForm<PersonalLoanKycFormInput, unknown, PersonalLoanKycFormValues>({
    resolver: zodResolver(schema),
    mode: "onTouched",
    // A hidden conditional field drops its value, so it can't block submit.
    shouldUnregister: true,
  });
  const employmentType = useWatch({ control, name: "employment_type" });
  const isLast = step === STEPS.length - 1;

  async function next() {
    // Validate only the current step before moving on.
    if (await trigger(STEPS[step]!.fields)) setStep(step + 1);
  }

  return (
    <form
      noValidate
      onSubmit={
        isLast
          ? handleSubmit(onSubmit)
          : (e) => {
              e.preventDefault();
              void next();
            }
      }
    >
      <h2>{"Personal loan KYC"}</h2>
      <p>
        Step {step + 1} of {STEPS.length}: {STEPS[step]!.title}
      </p>
      <progress value={step + 1} max={STEPS.length} aria-label="Form progress" />

      <section hidden={step !== 0} aria-label={"Basic details"}>
        <div>
          <label htmlFor="full_name">{"Full name"}<span aria-hidden="true"> *</span></label>
          <input id="full_name" type="text" autoComplete="off" {...register("full_name")} aria-invalid={errors["full_name"] ? true : undefined} aria-describedby={errors["full_name"] ? "full_name-error" : undefined} />
        {errors["full_name"] && <p id="full_name-error" role="alert">{errors["full_name"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="dob">{"Date of birth"}<span aria-hidden="true"> *</span></label>
          <input id="dob" type="date" autoComplete="off" {...register("dob")} aria-invalid={errors["dob"] ? true : undefined} aria-describedby={errors["dob"] ? "dob-error" : undefined} />
        {errors["dob"] && <p id="dob-error" role="alert">{errors["dob"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="mobile">{"Mobile number"}<span aria-hidden="true"> *</span></label>
          <input id="mobile" type="tel" inputMode="numeric" maxLength={10} autoComplete="off" {...register("mobile")} aria-invalid={errors["mobile"] ? true : undefined} aria-describedby={errors["mobile"] ? "mobile-error" : undefined} />
        {errors["mobile"] && <p id="mobile-error" role="alert">{errors["mobile"]?.message}</p>}
        </div>
      </section>

      <section hidden={step !== 1} aria-label={"Identity"}>
        <div>
          <input id="kyc_consent" type="checkbox" {...register("kyc_consent")} aria-invalid={errors["kyc_consent"] ? true : undefined} aria-describedby={errors["kyc_consent"] ? "kyc_consent-error" : undefined} />
          <label htmlFor="kyc_consent">{"I agree to share my PAN and Aadhaar for KYC"}<span aria-hidden="true"> *</span></label>
        {errors["kyc_consent"] && <p id="kyc_consent-error" role="alert">{errors["kyc_consent"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="pan_number">{"PAN"}<span aria-hidden="true"> *</span></label>
          <input id="pan_number" type="password" maxLength={10} autoComplete="off" {...register("pan_number")} aria-invalid={errors["pan_number"] ? true : undefined} aria-describedby={errors["pan_number"] ? "pan_number-error" : undefined} />
        {errors["pan_number"] && <p id="pan_number-error" role="alert">{errors["pan_number"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="aadhaar_last4">{"Last 4 digits of Aadhaar"}<span aria-hidden="true"> *</span></label>
          <input id="aadhaar_last4" type="password" inputMode="numeric" maxLength={4} autoComplete="off" {...register("aadhaar_last4")} aria-invalid={errors["aadhaar_last4"] ? true : undefined} aria-describedby={errors["aadhaar_last4"] ? "aadhaar_last4-error" : undefined} />
        {errors["aadhaar_last4"] && <p id="aadhaar_last4-error" role="alert">{errors["aadhaar_last4"]?.message}</p>}
        </div>
      </section>

      <section hidden={step !== 2} aria-label={"Income and bank"}>
        <fieldset aria-describedby={errors["employment_type"] ? "employment_type-error" : undefined}>
          <legend>{"Employment type"}<span aria-hidden="true"> *</span></legend>
          <label>
            <input type="radio" value={"salaried"} {...register("employment_type")} /> {"Salaried"}
          </label>
          <label>
            <input type="radio" value={"self_employed"} {...register("employment_type")} /> {"Self-employed"}
          </label>
        {errors["employment_type"] && <p id="employment_type-error" role="alert">{errors["employment_type"]?.message}</p>}
        </fieldset>

        {employmentType === "self_employed" && (
          <div>
            <label htmlFor="gstin">{"GSTIN"}<span aria-hidden="true"> *</span></label>
            <input id="gstin" type="text" maxLength={15} autoComplete="off" {...register("gstin")} aria-invalid={errors["gstin"] ? true : undefined} aria-describedby={errors["gstin"] ? "gstin-error" : undefined} />
          {errors["gstin"] && <p id="gstin-error" role="alert">{errors["gstin"]?.message}</p>}
          </div>
        )}

        <div>
          <label htmlFor="monthly_income">{"Monthly income (₹)"}<span aria-hidden="true"> *</span></label>
          <input id="monthly_income" type="text" inputMode="decimal" autoComplete="off" {...register("monthly_income")} aria-invalid={errors["monthly_income"] ? true : undefined} aria-describedby={errors["monthly_income"] ? "monthly_income-error" : undefined} />
        {errors["monthly_income"] && <p id="monthly_income-error" role="alert">{errors["monthly_income"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="ifsc">{"Bank IFSC"}<span aria-hidden="true"> *</span></label>
          <input id="ifsc" type="text" maxLength={11} autoComplete="off" {...register("ifsc")} aria-invalid={errors["ifsc"] ? true : undefined} aria-describedby={errors["ifsc"] ? "ifsc-error" : undefined} />
        {errors["ifsc"] && <p id="ifsc-error" role="alert">{errors["ifsc"]?.message}</p>}
        </div>

        <div>
          <label htmlFor="account_number">{"Bank account number"}<span aria-hidden="true"> *</span></label>
          <input id="account_number" type="password" inputMode="numeric" maxLength={18} autoComplete="off" {...register("account_number")} aria-invalid={errors["account_number"] ? true : undefined} aria-describedby={errors["account_number"] ? "account_number-error" : undefined} />
        {errors["account_number"] && <p id="account_number-error" role="alert">{errors["account_number"]?.message}</p>}
        </div>
      </section>

      <div>
        <button type="button" onClick={() => setStep(step - 1)} disabled={step === 0}>
          Back
        </button>
        <button type="submit">{isLast ? "Submit" : "Next"}</button>
      </div>
    </form>
  );
}
"
`;
